    <version>1.0.0</version>
    <packaging>pom</packaging>
    <dependencies>
        <dependency>
            <groupId>com.sw.ck</groupId>
            <artifactId>sw-basic-iot-api</artifactId>
            <version>0.2.0</version>
        </dependency>
    </dependencies>
</project>
