{
  "contract": "agent-coding-engine.executor-terminal.v2",
  "marker": "ENGINE_TERMINAL",
  "additionalProperties": false,
  "required": ["schema", "role", "state", "task_level", "evidence"],
  "properties": {
    "schema": {"type": "string", "const": "agent-coding-engine.executor-terminal.v2"},
    "role": {"type": "string", "const": "executor"},
    "state": {"type": "string", "enum": ["TASK_COMPLETED", "EXECUTION_SUBMITTED", "TERMINAL_SYNC_SUBMITTED", "BLOCKED"]},
    "task_level": {"type": "string", "enum": ["S", "M", "L", "XL"]},
    "receipt": {"type": "string", "minLength": 1, "pattern": "^product/[^/]+/receipts/[^/]+\\.md$"},
    "evidence": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "feature_status": {"type": "string", "enum": ["READY", "IN_PROGRESS", "VERIFYING", "PASSED", "COMPLETED"]},
    "memory_compression": {"type": "object", "additionalProperties": false, "required": ["before_bytes", "after_bytes"], "properties": {"before_bytes": {"type": "integer", "minimum": 0}, "after_bytes": {"type": "integer", "minimum": 0}}},
    "block_type": {"type": "string", "enum": ["EXTERNAL", "DIRECTION_CONFLICT", "ENVIRONMENT", "EVIDENCE_GAP"]},
    "attempted": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "release_condition": {"type": "string", "minLength": 1}
  },
  "states": {
    "TASK_COMPLETED": {
      "required": [],
      "allowed": ["schema", "role", "state", "task_level", "evidence"],
      "forbidden": ["receipt", "feature_status", "memory_compression", "block_type", "attempted", "release_condition"],
      "allowedTaskLevels": ["S", "M"],
      "allowedFeatureStatus": [],
      "receiptRequiredTaskLevels": []
    },
    "EXECUTION_SUBMITTED": {
      "required": ["receipt", "feature_status"],
      "allowed": ["schema", "role", "state", "task_level", "receipt", "evidence", "feature_status"],
      "forbidden": ["memory_compression", "block_type", "attempted", "release_condition"],
      "allowedTaskLevels": ["L", "XL"],
      "allowedFeatureStatus": ["IN_PROGRESS", "VERIFYING"],
      "receiptRequiredTaskLevels": ["L", "XL"]
    },
    "TERMINAL_SYNC_SUBMITTED": {
      "required": ["receipt", "feature_status", "memory_compression"],
      "allowed": ["schema", "role", "state", "task_level", "receipt", "evidence", "feature_status", "memory_compression"],
      "forbidden": ["block_type", "attempted", "release_condition"],
      "allowedTaskLevels": ["L", "XL"],
      "allowedFeatureStatus": ["COMPLETED"],
      "receiptRequiredTaskLevels": ["L", "XL"]
    },
    "BLOCKED": {
      "required": ["block_type", "attempted", "release_condition"],
      "allowed": ["schema", "role", "state", "task_level", "receipt", "evidence", "block_type", "attempted", "release_condition"],
      "forbidden": ["feature_status", "memory_compression"],
      "allowedTaskLevels": ["S", "M", "L", "XL"],
      "allowedFeatureStatus": [],
      "receiptRequiredTaskLevels": ["L", "XL"]
    }
  }
}
