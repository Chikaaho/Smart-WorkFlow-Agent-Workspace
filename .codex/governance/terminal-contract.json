{
  "contract": "agent-coding-engine.executor-terminal.v2",
  "marker": "ENGINE_TERMINAL",
  "additionalProperties": false,
  "required": ["schema", "role", "state", "task_level", "evidence"],
  "properties": {
    "schema": {"type": "string", "const": "agent-coding-engine.executor-terminal.v2"},
    "role": {"type": "string", "const": "executor"},
    "state": {"type": "string", "enum": ["TASK_COMPLETED", "EXECUTION_SUBMITTED", "TERMINAL_SYNC_SUBMITTED", "BLOCKED"]},
    "task_level": {"type": "string", "enum": ["S", "M", "L", "XL"]},
    "receipt": {"type": "string", "minLength": 1, "pattern": "^product/[^/]+/receipts/[^/]+\\.md$"},
    "evidence": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "feature_status": {"type": "string", "enum": ["READY", "IN_PROGRESS", "VERIFYING", "PASSED", "COMPLETED"]},
    "memory_compression": {"type": "object", "additionalProperties": false, "required": ["before_bytes", "after_bytes"], "properties": {"before_bytes": {"type": "integer", "minimum": 0}, "after_bytes": {"type": "integer", "minimum": 0}}},
    "block_type": {"type": "string", "enum": ["EXTERNAL", "DIRECTION_CONFLICT", "ENVIRONMENT", "EVIDENCE_GAP", "PERMISSION_DENIED", "CAPABILITY_UNAVAILABLE"]},
    "attempted": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "release_condition": {"type": "string", "minLength": 1},
    "work_items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "status", "authorized", "dependency_satisfied", "actionable", "next_action"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "status": {"type": "string", "enum": ["PENDING", "IN_PROGRESS", "COMPLETED", "BLOCKED"]},
          "authorized": {"type": "boolean"},
          "dependency_satisfied": {"type": "boolean"},
          "actionable": {"type": "boolean"},
          "next_action": {"type": "string", "minLength": 1}
        }
      }
    },
    "remaining_actionable_count": {"type": "integer", "minimum": 0},
    "independent_work_exhausted": {"type": "boolean"},
    "next_action": {"type": "string", "minLength": 1},
    "next_action_type": {"type": "string", "enum": ["CONTINUE", "WAIT_PLANNER", "WAIT_EXTERNAL", "REPLAN"]},
    "progress_fingerprint": {"type": "string", "minLength": 1},
    "progress_basis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["files_changed", "tool_actions", "new_evidence", "closed_work_items"],
      "properties": {
        "files_changed": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "tool_actions": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "new_evidence": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "closed_work_items": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }
    },
    "stop_reason": {"type": "string", "enum": ["WAITING_FOR_PLANNER", "EXTERNAL_DEPENDENCY", "DIRECTION_CONFLICT", "ENVIRONMENT_UNAVAILABLE", "EVIDENCE_GAP", "PERMISSION_DENIED", "CAPABILITY_UNAVAILABLE"]},
    "tool_results": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["tool", "outcome", "detail"],
        "properties": {
          "tool": {"type": "string", "minLength": 1},
          "outcome": {"type": "string", "enum": ["SUCCEEDED", "FAILED", "DENIED", "UNAVAILABLE", "TIMEOUT", "REQUIRES_SECRET", "REQUIRES_MFA", "REQUIRES_HUMAN_VERIFICATION"]},
          "detail": {"type": "string", "minLength": 1}
        }
      }
    },
    "browser_status": {"type": "string", "enum": ["NOT_APPLICABLE", "OPERABLE", "UNAVAILABLE", "REQUIRES_SECRET", "REQUIRES_MFA", "REQUIRES_HUMAN_VERIFICATION"]},
    "browser_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tier", "headless"],
      "properties": {
        "tier": {"type": "string", "enum": ["FORMAL_FLOW", "ISOLATED_REGRESSION", "COMPONENT_TEST"]},
        "headless": {"type": "boolean"},
        "artifacts": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "url": {"type": "string", "minLength": 1},
        "viewport": {"type": "string", "minLength": 1},
        "identity": {"type": "string", "minLength": 1},
        "object": {"type": "string", "minLength": 1},
        "network_index": {"type": "string", "minLength": 1}
      }
    },
    "formal_browser_acceptance": {"type": "boolean"},
    "execution_tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "work_item_id",
          "input",
          "expected_output",
          "completion_condition",
          "handle",
          "cancel_action",
          "cleanup_action",
          "status",
          "execution_mode",
          "validation_scope",
          "wait_strategy",
          "failure_policy",
          "work_limit",
          "timeout_seconds",
          "progress_timeout_seconds",
          "started_at",
          "deadline_at",
          "last_progress_at",
          "cleanup_complete",
          "exit_code",
          "result_paths",
          "progress"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "work_item_id": {
            "type": "string",
            "minLength": 1
          },
          "input": {
            "type": "string",
            "minLength": 1
          },
          "expected_output": {
            "type": "string",
            "minLength": 1
          },
          "completion_condition": {
            "type": "string",
            "minLength": 1
          },
          "handle": {
            "type": "string",
            "minLength": 1
          },
          "cancel_action": {
            "type": "string",
            "minLength": 1
          },
          "cleanup_action": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "string",
            "enum": [
              "PREPARED",
              "RUNNING",
              "SUCCEEDED",
              "FAILED",
              "TIMED_OUT",
              "CANCELLED"
            ]
          },
          "execution_mode": {
            "type": "string",
            "enum": [
              "FOREGROUND",
              "MANAGED_BACKGROUND"
            ]
          },
          "validation_scope": {
            "type": "string",
            "const": "MINIMAL_SUFFICIENT"
          },
          "wait_strategy": {
            "type": "string",
            "enum": [
              "RESULT",
              "EVENT"
            ]
          },
          "failure_policy": {
            "type": "string",
            "const": "CANCEL_AND_SAVE"
          },
          "work_limit": {
            "type": "integer",
            "minimum": 1
          },
          "timeout_seconds": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "progress_timeout_seconds": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "started_at": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "deadline_at": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "last_progress_at": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "cleanup_complete": {
            "type": "boolean"
          },
          "exit_code": {
            "type": [
              "integer",
              "null"
            ]
          },
          "result_paths": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "progress": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "sequence",
              "processed_units",
              "phase",
              "result_count",
              "error"
            ],
            "properties": {
              "sequence": {
                "type": "integer",
                "minimum": 0
              },
              "processed_units": {
                "type": "integer",
                "minimum": 0
              },
              "phase": {
                "type": "string",
                "enum": [
                  "PREPARED",
                  "PROCESSING",
                  "FINALIZING",
                  "FINISHED",
                  "ERROR"
                ]
              },
              "result_count": {
                "type": "integer",
                "minimum": 0
              },
              "error": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "confirmation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["category", "input_source", "action"],
      "properties": {
        "category": {"type": "string", "enum": ["SECRET", "MFA", "HUMAN_VERIFICATION", "DESTRUCTIVE", "REMOTE_PUBLISH", "OUT_OF_AUTHORIZATION", "DETERMINISTIC_LOCAL_INPUT"]},
        "input_source": {"type": "string", "enum": ["DEV_TEST_CONFIG", "EXISTING_TEST_CONTRACT", "USER_SECRET", "EXTERNAL_SYSTEM", "NONE"]},
        "action": {"type": "string", "minLength": 1}
      }
    }
  },
  "states": {
    "TASK_COMPLETED": {
      "required": [],
      "allowed": ["schema", "role", "state", "task_level", "evidence", "execution_tasks"],
      "forbidden": ["receipt", "feature_status", "memory_compression", "block_type", "attempted", "release_condition", "work_items", "remaining_actionable_count", "independent_work_exhausted", "next_action", "next_action_type", "progress_fingerprint", "progress_basis", "stop_reason", "tool_results", "browser_status", "browser_evidence", "formal_browser_acceptance", "confirmation"],
      "allowedTaskLevels": ["S", "M"],
      "allowedFeatureStatus": [],
      "receiptRequiredTaskLevels": []
    },
    "EXECUTION_SUBMITTED": {
      "required": ["receipt", "feature_status", "work_items", "remaining_actionable_count", "independent_work_exhausted", "next_action", "next_action_type", "progress_fingerprint", "progress_basis", "stop_reason", "tool_results", "browser_status"],
      "allowed": ["schema", "role", "state", "task_level", "receipt", "evidence", "feature_status", "work_items", "remaining_actionable_count", "independent_work_exhausted", "next_action", "next_action_type", "progress_fingerprint", "progress_basis", "stop_reason", "tool_results", "browser_status", "browser_evidence", "formal_browser_acceptance", "execution_tasks"],
      "forbidden": ["memory_compression", "block_type", "attempted", "release_condition", "confirmation"],
      "allowedTaskLevels": ["L", "XL"],
      "allowedFeatureStatus": ["IN_PROGRESS", "VERIFYING"],
      "receiptRequiredTaskLevels": ["L", "XL"]
    },
    "TERMINAL_SYNC_SUBMITTED": {
      "required": ["receipt", "feature_status", "memory_compression", "work_items", "remaining_actionable_count", "independent_work_exhausted", "next_action", "next_action_type", "progress_fingerprint", "progress_basis", "stop_reason", "tool_results", "browser_status"],
      "allowed": ["schema", "role", "state", "task_level", "receipt", "evidence", "feature_status", "memory_compression", "work_items", "remaining_actionable_count", "independent_work_exhausted", "next_action", "next_action_type", "progress_fingerprint", "progress_basis", "stop_reason", "tool_results", "browser_status", "browser_evidence", "formal_browser_acceptance", "execution_tasks"],
      "forbidden": ["block_type", "attempted", "release_condition", "confirmation"],
      "allowedTaskLevels": ["L", "XL"],
      "allowedFeatureStatus": ["COMPLETED"],
      "receiptRequiredTaskLevels": ["L", "XL"]
    },
    "BLOCKED": {
      "required": ["block_type", "attempted", "release_condition", "work_items", "remaining_actionable_count", "independent_work_exhausted", "next_action", "next_action_type", "progress_fingerprint", "progress_basis", "stop_reason", "tool_results", "browser_status"],
      "allowed": ["schema", "role", "state", "task_level", "receipt", "evidence", "block_type", "attempted", "release_condition", "work_items", "remaining_actionable_count", "independent_work_exhausted", "next_action", "next_action_type", "progress_fingerprint", "progress_basis", "stop_reason", "tool_results", "browser_status", "confirmation", "execution_tasks"],
      "forbidden": ["feature_status", "memory_compression", "browser_evidence", "formal_browser_acceptance"],
      "allowedTaskLevels": ["S", "M", "L", "XL"],
      "allowedFeatureStatus": [],
      "receiptRequiredTaskLevels": ["L", "XL"]
    }
  },
  "behavioralRules": {
    "executionLifecycle": {"activeStatuses": ["PREPARED", "RUNNING"], "finalStatuses": ["SUCCEEDED", "FAILED", "TIMED_OUT", "CANCELLED"], "immutableFields": ["id", "work_item_id", "input", "expected_output", "completion_condition", "handle", "execution_mode", "validation_scope", "wait_strategy", "failure_policy", "work_limit", "timeout_seconds", "progress_timeout_seconds", "started_at", "deadline_at", "cancel_action", "cleanup_action"], "requiresHostObservation": true, "terminalRequiresCleanupAndExit": true, "unchangedObservationIsNotProgress": true, "noDurationExemption": true, "splitTasksShareWorkItemBudget": true},
    "actionableItem": "status is PENDING or IN_PROGRESS, authorized is true, dependency_satisfied is true, and actionable is true",
    "submissionStatesRequireZeroActionable": true,
    "blockedRequiresIndependentWorkExhausted": true,
    "blockedRequiresToolResult": true,
    "operableBrowserCannotBeExternalBlocker": true,
    "permissionBlockRequiresDeniedToolResult": true,
    "capabilityBlockRequiresUnavailableToolResult": true,
    "formalBrowserAcceptanceRequiresFormalTier": true,
    "formalBrowserTierRequiresVisibleSession": true,
    "formalBrowserTierRequiresReadableEvidence": true,
    "authorizedDeterministicInputIsContinueAction": true,
    "userConfirmationRequiresExternalInputSource": true,
    "secretConfirmationRequiresMatchingToolResult": true
  },
  "hookInput": {
    "background_tasks": {"optional": true, "description": "宿主已知任务清单；仅宿主确认为 owner=USER 的既有服务排除，代理任务必须关联真实 execution_tasks 观察。"},
    "execution_observations": {
      "optional": true,
      "properties": ["browser_status", "browser_evidence", "tool_results", "progress_fingerprint", "execution_tasks"]
    },
    "progress_guard": {
      "optional": true,
      "properties": ["previous_fingerprint", "repeat_count", "observed_progress"]
    },
    "supervisor": {
      "optional": true,
      "properties": ["attempt", "max_attempts", "last_action"]
    }
  }
}
