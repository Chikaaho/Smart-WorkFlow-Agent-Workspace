{
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "engine_root=\"${CODEX_PROJECT_DIR:-${CLAUDE_PROJECT_DIR:-$PWD}}\"; while [ ! -f \"$engine_root/.codex/governance/stop-gate.sh\" ] && [ \"$engine_root\" != \"/\" ]; do engine_root=\"$(dirname \"$engine_root\")\"; done; [ -f \"$engine_root/.codex/governance/stop-gate.sh\" ] || exit 0; sh \"$engine_root/.codex/hooks/codex-stop-adapter.sh\"",
            "commandWindows": "powershell.exe -NoLogo -NoProfile -NonInteractive -ExecutionPolicy Bypass -EncodedCommand "
          }
        ]
      }
    ]
  }
}
